{
  "documentationUrl": "https://github.com/AndreyVMarkelov/airbyte-source-dropbox",
  "connectionSpecification": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "Dropbox Destination Spec",
    "type": "object",
    "required": [
      "credentials"
    ],
    "additionalProperties": false,
    "properties": {
      "credentials": {
        "title": "Dropbox authentication",
        "description": "Requires account_info.read and files.metadata.read. Uploading additionally requires files.content.write.",
        "type": "object",
        "oneOf": [
          {
            "title": "OAuth 2.0 refresh token (recommended)",
            "required": [
              "auth_type",
              "app_key",
              "refresh_token"
            ],
            "additionalProperties": false,
            "properties": {
              "auth_type": {
                "type": "string",
                "const": "oauth2_pkce",
                "order": 0
              },
              "app_key": {
                "title": "Dropbox App Key",
                "type": "string",
                "order": 1
              },
              "refresh_token": {
                "title": "Dropbox Refresh Token",
                "type": "string",
                "airbyte_secret": true,
                "order": 2
              }
            }
          },
          {
            "title": "Access token (development/manual testing only)",
            "required": [
              "auth_type",
              "access_token"
            ],
            "additionalProperties": false,
            "properties": {
              "auth_type": {
                "type": "string",
                "const": "access_token",
                "order": 0
              },
              "access_token": {
                "title": "Dropbox Access Token",
                "type": "string",
                "airbyte_secret": true,
                "order": 1
              }
            }
          }
        ]
      },
      "root_path": {
        "title": "Dropbox destination root",
        "description": "Existing Dropbox folder under which relative record paths are resolved. The destination creates child folders only. Use an empty value for the app root.",
        "type": "string",
        "default": "",
        "examples": [
          "",
          "/Exports"
        ]
      },
      "max_file_size_mb": {
        "title": "Maximum decoded file size (MB)",
        "description": "Maximum decoded content_base64 size uploaded per record. Files above the upload-session threshold use sequential Dropbox upload sessions.",
        "type": "integer",
        "minimum": 1,
        "maximum": 64,
        "default": 10
      },
      "upload_session_threshold_mb": {
        "title": "Upload Session Threshold (MB)",
        "description": "Decoded files larger than this threshold use sequential Dropbox upload sessions.",
        "type": "integer",
        "minimum": 1,
        "maximum": 64,
        "default": 8
      },
      "upload_chunk_size_mb": {
        "title": "Upload Session Chunk Size (MB)",
        "description": "Decoded byte size of each sequential upload-session chunk.",
        "type": "integer",
        "minimum": 1,
        "maximum": 16,
        "default": 8
      },
      "conflict_policy": {
        "title": "File conflict policy",
        "description": "overwrite replaces an existing file and is safe for replay. fail stops the sync if the destination path already contains a file.",
        "type": "string",
        "enum": [
          "overwrite",
          "fail"
        ],
        "default": "overwrite"
      },
      "metadata_policy": {
        "title": "Client-modified timestamp policy",
        "description": "preserve sends a supplied modified_at value as Dropbox client_modified. ignore lets Dropbox assign its default timestamp.",
        "type": "string",
        "enum": [
          "preserve",
          "ignore"
        ],
        "default": "preserve"
      },
      "team_context": {
        "title": "Dropbox Business",
        "description": "Optional Dropbox Business member/admin context. Leave as none for personal accounts and ordinary user-linked tokens.",
        "type": "object",
        "oneOf": [
          {
            "title": "Use current account",
            "required": [
              "mode"
            ],
            "additionalProperties": false,
            "properties": {
              "mode": {
                "title": "Team context mode",
                "type": "string",
                "const": "none",
                "default": "none"
              },
              "select_user": {
                "title": "Legacy selected member",
                "type": "null",
                "airbyte_hidden": true,
                "default": null
              },
              "select_admin": {
                "title": "Legacy selected admin",
                "type": "null",
                "airbyte_hidden": true,
                "default": null
              }
            }
          },
          {
            "title": "Act as team member",
            "required": [
              "mode",
              "select_user"
            ],
            "additionalProperties": false,
            "properties": {
              "mode": {
                "title": "Team context mode",
                "type": "string",
                "const": "user"
              },
              "select_user": {
                "title": "Select member",
                "description": "Dropbox Business team member ID, for example dbmid:...",
                "type": "string"
              },
              "select_admin": {
                "title": "Legacy selected admin",
                "type": "null",
                "airbyte_hidden": true,
                "default": null
              }
            }
          },
          {
            "title": "Act as team admin",
            "required": [
              "mode",
              "select_admin"
            ],
            "additionalProperties": false,
            "properties": {
              "mode": {
                "title": "Team context mode",
                "type": "string",
                "const": "admin"
              },
              "select_admin": {
                "title": "Select admin",
                "description": "Dropbox Business admin member ID, for example dbmid:...",
                "type": "string"
              },
              "select_user": {
                "title": "Legacy selected member",
                "type": "null",
                "airbyte_hidden": true,
                "default": null
              }
            }
          }
        ],
        "default": {
          "mode": "none"
        }
      },
      "path_root": {
        "title": "Dropbox Root",
        "description": "Optional Dropbox Path Root. Use default behavior, member home, account/team root, or an explicit namespace ID.",
        "type": "object",
        "oneOf": [
          {
            "title": "Default Dropbox root",
            "required": [
              "mode"
            ],
            "additionalProperties": false,
            "properties": {
              "mode": {
                "title": "Root mode",
                "type": "string",
                "const": "default",
                "default": "default"
              },
              "namespace_id": {
                "title": "Legacy namespace ID",
                "type": "null",
                "airbyte_hidden": true,
                "default": null
              }
            }
          },
          {
            "title": "Member home",
            "required": [
              "mode"
            ],
            "additionalProperties": false,
            "properties": {
              "mode": {
                "title": "Root mode",
                "type": "string",
                "const": "home"
              },
              "namespace_id": {
                "title": "Legacy namespace ID",
                "type": "null",
                "airbyte_hidden": true,
                "default": null
              }
            }
          },
          {
            "title": "Team/account root",
            "required": [
              "mode"
            ],
            "additionalProperties": false,
            "properties": {
              "mode": {
                "title": "Root mode",
                "type": "string",
                "const": "root"
              },
              "namespace_id": {
                "title": "Legacy namespace ID",
                "type": "null",
                "airbyte_hidden": true,
                "default": null
              }
            }
          },
          {
            "title": "Explicit namespace ID",
            "required": [
              "mode",
              "namespace_id"
            ],
            "additionalProperties": false,
            "properties": {
              "mode": {
                "title": "Root mode",
                "type": "string",
                "const": "namespace_id"
              },
              "namespace_id": {
                "title": "Namespace ID",
                "description": "Explicit Dropbox namespace/root ID.",
                "type": "string"
              }
            }
          }
        ],
        "default": {
          "mode": "default"
        }
      }
    }
  }
}
