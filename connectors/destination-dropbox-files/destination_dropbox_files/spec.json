{
  "documentationUrl": "https://github.com/AndreyVMarkelov/airbyte-source-dropbox",
  "connectionSpecification": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "Dropbox Files Destination Spec",
    "type": "object",
    "required": ["credentials"],
    "additionalProperties": false,
    "properties": {
      "credentials": {
        "title": "Dropbox authentication",
        "type": "object",
        "oneOf": [
          {"title": "OAuth 2.0 refresh token (recommended)", "required": ["auth_type", "app_key", "refresh_token"], "additionalProperties": false, "properties": {"auth_type": {"type": "string", "const": "oauth2_pkce"}, "app_key": {"type": "string"}, "refresh_token": {"type": "string", "airbyte_secret": true}}},
          {"title": "Access token (development only)", "required": ["auth_type", "access_token"], "additionalProperties": false, "properties": {"auth_type": {"type": "string", "const": "access_token"}, "access_token": {"type": "string", "airbyte_secret": true}}}
        ]
      },
      "root_path": {"title": "Dropbox destination root", "type": "string", "default": ""},
      "upload_chunk_size_mb": {"title": "Upload chunk size (MB)", "type": "integer", "minimum": 1, "maximum": 16, "default": 8},
      "conflict_policy": {"type": "string", "enum": ["overwrite", "fail"], "default": "overwrite"},
      "metadata_policy": {"title": "Client-modified timestamp policy", "description": "preserve uses source client_modified when supplied; ignore lets Dropbox assign its default timestamp.", "type": "string", "enum": ["preserve", "ignore"], "default": "preserve"}
    }
  }
}
